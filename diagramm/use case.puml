@startuml
left to right direction
skinparam packageStyle rectangle

actor "Клиент" as Client
actor "Курьер" as Courier
actor "Оператор" as Operator

rectangle "Система учёта доставки заказов" {
  usecase "Оформить заказ" as UC1
  usecase "Оплатить заказ" as UC2
  usecase "Получить заказ" as UC3
  usecase "Отследить заказ" as UC4

  usecase "Регистрация" as UC5
  usecase "Принять заказ" as UC6
  usecase "Доставить заказ" as UC7

  usecase "Регистрация " as UC8
  usecase "Обработать заказ" as UC9
  usecase "Назначить курьера" as UC10
}

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC4

Courier --> UC5
Courier --> UC6
Courier --> UC7
Courier --> UC4

Operator --> UC8
Operator --> UC9
Operator --> UC10

@enduml